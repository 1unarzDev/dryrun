{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "homeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "roomID": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 4096
    },
    "orientation": {
      "type": "string",
      "enum": [
        "up",
        "right",
        "down",
        "left"
      ]
    },
    "transforms": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "crop",
              "resize",
              "rotate",
              "redact"
            ]
          },
          "values": {
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "kind",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "calibration": {
      "type": "string",
      "enum": [
        "none",
        "submittedFrameAligned"
      ]
    },
    "redactedRegions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "items": false,
        "minItems": 4,
        "maxItems": 4
      }
    }
  },
  "required": [
    "id",
    "homeRevision",
    "roomID",
    "digest",
    "capturedAt",
    "width",
    "height",
    "orientation",
    "transforms",
    "calibration",
    "redactedRegions"
  ],
  "additionalProperties": false
}
