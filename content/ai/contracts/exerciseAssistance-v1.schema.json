{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "personID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "helperID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reachStatus": {
      "type": "string",
      "enum": [
        "reachable",
        "unreachable",
        "unknown",
        "missingHelper"
      ]
    },
    "sharedWithPersonIDs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "simultaneousCapacity": {
      "type": "string",
      "enum": [
        "notAssessed",
        "unknown"
      ]
    }
  },
  "required": [
    "personID",
    "reachStatus",
    "sharedWithPersonIDs",
    "simultaneousCapacity"
  ],
  "additionalProperties": false
}
