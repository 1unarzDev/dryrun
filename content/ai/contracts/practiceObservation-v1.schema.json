{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "competencyID": {
      "type": "string",
      "enum": [
        "initialResponse",
        "adaptation",
        "communication",
        "continuity"
      ]
    },
    "actionID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "acceptedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "receiptDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credit": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 0.5
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "feedbackRevealed": {
      "type": "boolean"
    }
  },
  "required": [
    "competencyID",
    "actionID",
    "acceptedRevision",
    "receiptDigest",
    "feedbackRevealed"
  ],
  "additionalProperties": false
}
