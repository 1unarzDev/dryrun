{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "dryrun.director-proposal/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "requestID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "actor": {
      "type": "string",
      "const": "director"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding": {
      "type": "object",
      "properties": {
        "sessionID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "householdRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "homeRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sessionID",
        "revision",
        "eventSequence",
        "contextDigest",
        "householdRevision",
        "homeRevision"
      ],
      "additionalProperties": false
    },
    "commands": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "schedule"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4320
              }
            },
            "required": [
              "kind",
              "target",
              "minute"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "startIncident"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "hazard": {
                "type": "string",
                "enum": [
                  "freezePowerLoss",
                  "heatGridStrain",
                  "tornado",
                  "flashFlood",
                  "homeFire",
                  "waterOutage"
                ]
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4320
              }
            },
            "required": [
              "kind",
              "target",
              "hazard",
              "minute"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "advanceIncident"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "hazard": {
                "type": "string",
                "enum": [
                  "freezePowerLoss",
                  "heatGridStrain",
                  "tornado",
                  "flashFlood",
                  "homeFire",
                  "waterOutage"
                ]
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4320
              }
            },
            "required": [
              "kind",
              "target",
              "hazard",
              "minute"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "advance"
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4320
              }
            },
            "required": [
              "kind",
              "minute"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "waitUntil"
              },
              "target": {
                "type": "string",
                "enum": [
                  "nextIncident",
                  "storedWaterUnavailable",
                  "primaryContactChannelUnavailable"
                ]
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4320
              }
            },
            "required": [
              "kind",
              "target",
              "durationMinutes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "requestDecision"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "finish"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "evidenceIDs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "assumptionIDs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "nextBoundary": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pauseForDecision",
            "finishExercise",
            "advanceUntilHostBoundary",
            "scheduledIncident",
            "noAdvance"
          ]
        },
        "requestedMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4320
        },
        "maximumDurationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4320
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "presentationIntent": {
      "type": "object",
      "properties": {
        "focus": {
          "type": "string",
          "enum": [
            "decision",
            "summary",
            "scene",
            "resources"
          ]
        },
        "sceneFirst": {
          "type": "boolean",
          "const": true
        },
        "renderFrom": {
          "type": "string",
          "const": "committedReceipt"
        },
        "narration": {
          "type": "string",
          "const": "unverifiedProposal"
        }
      },
      "required": [
        "focus",
        "sceneFirst",
        "renderFrom",
        "narration"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "id",
    "requestID",
    "actor",
    "baseRevision",
    "binding",
    "commands",
    "purpose",
    "evidenceIDs",
    "assumptionIDs",
    "nextBoundary",
    "presentationIntent"
  ],
  "additionalProperties": false
}
