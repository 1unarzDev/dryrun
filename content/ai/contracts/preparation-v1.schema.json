{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tasks": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "destination": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "contact"
                  },
                  "contactRole": {
                    "type": "string",
                    "enum": [
                      "outOfAreaContact",
                      "neighborHelper",
                      "transportSupport",
                      "careProvider",
                      "utilityMedicalRegistry",
                      "waterUtility",
                      "other"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "contactRole"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "family"
                  },
                  "subjectID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "equipment"
                  },
                  "subjectID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "subjectID"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "meeting"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "outsideMeetingPoint",
                      "backupMeetingPlace",
                      "fallbackDestination",
                      "exteriorHydrant",
                      "homeReference"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "purpose"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "home"
                  },
                  "subjectID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "checklist"
                  },
                  "checklistID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "titleKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "checklistID",
                  "titleKey"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "backups"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "transport"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "homeSetup"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "review"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "water"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "communications"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "housing"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "supplies"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "bespoke": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "implication": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "completionCheck": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "title",
              "fact",
              "implication",
              "action",
              "completionCheck"
            ],
            "additionalProperties": false
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "actionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "criterionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "subjectID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidenceIDs": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "completionPredicates": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "editor": {
            "type": "string",
            "enum": [
              "family",
              "contacts",
              "supplies",
              "medical",
              "home",
              "meetingPlace"
            ]
          },
          "dependencyIDs": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "actionID",
          "criterionID",
          "subjectID",
          "why",
          "evidenceIDs",
          "completionPredicates",
          "editor",
          "dependencyIDs",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "inventoryObservations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "physicalID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "enum": [
              "water",
              "food",
              "light",
              "firstAid",
              "sanitation",
              "medication",
              "petSupplies",
              "infantSupplies",
              "power",
              "fuel",
              "communication",
              "other"
            ]
          },
          "preparationKind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "flashlight",
                  "firstAidKit"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "liter",
              "usGallon",
              "count",
              "wattHour",
              "day"
            ]
          },
          "evidenceIDs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "unknowns": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "required": [
          "id",
          "physicalID",
          "category",
          "quantity",
          "unit",
          "evidenceIDs",
          "unknowns"
        ],
        "additionalProperties": false
      }
    },
    "question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tasks",
    "inventoryObservations",
    "question"
  ],
  "additionalProperties": false
}
