{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "dryrun.committed-action-context/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "target": {
      "type": "string",
      "maxLength": 120
    },
    "value": {
      "type": "string",
      "maxLength": 120
    },
    "commitRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "commandIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "additionalProperties": false
}
