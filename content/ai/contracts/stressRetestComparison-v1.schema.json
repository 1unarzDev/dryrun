{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "dryrun.stress-comparison/1"
    },
    "baselineMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4320
    },
    "retestMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4320
    },
    "commonHorizonReached": {
      "type": "boolean"
    },
    "resolvedRequirementIDs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "remainingRequirementIDs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "newlyUnmetRequirementIDs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "remainingUnknownIDs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  },
  "required": [
    "version",
    "baselineMinute",
    "retestMinute",
    "commonHorizonReached",
    "resolvedRequirementIDs",
    "remainingRequirementIDs",
    "newlyUnmetRequirementIDs",
    "remainingUnknownIDs"
  ],
  "additionalProperties": false
}
