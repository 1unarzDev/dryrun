{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "dryrun.site-context/1"
    },
    "elevationRecorded": {
      "type": "boolean"
    },
    "floodComparison": {
      "type": "string",
      "enum": [
        "unknown",
        "aboveDesignLevel",
        "belowDesignLevel",
        "overlappingUncertainty"
      ]
    },
    "wildfireRating": {
      "type": "string",
      "enum": [
        "veryLow",
        "low",
        "moderate",
        "high",
        "veryHigh"
      ]
    },
    "wildfireScale": {
      "type": "string",
      "enum": [
        "community",
        "parcel"
      ]
    },
    "hurricanePlan": {
      "type": "string",
      "enum": [
        "unknown",
        "recordedOfficialPlanningRoute"
      ]
    },
    "sourceIDs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "sources": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "jurisdictionID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "datasetVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "publisher",
          "jurisdictionID",
          "retrievedAt",
          "validUntil"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "required": [
    "schemaVersion",
    "elevationRecorded",
    "floodComparison",
    "hurricanePlan",
    "sourceIDs",
    "limitations"
  ],
  "additionalProperties": false
}
