{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "routes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "primary": {
            "type": "object",
            "properties": {
              "spaceSequence": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "portalSequence": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "connectorSequence": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "verificationNeeded": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "required": [
              "spaceSequence",
              "portalSequence",
              "connectorSequence",
              "verificationNeeded"
            ],
            "additionalProperties": false
          },
          "alternative": {
            "type": "object",
            "properties": {
              "spaceSequence": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "portalSequence": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "connectorSequence": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "verificationNeeded": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "required": [
              "spaceSequence",
              "portalSequence",
              "connectorSequence",
              "verificationNeeded"
            ],
            "additionalProperties": false
          },
          "alternativeStatus": {
            "type": "string",
            "enum": [
              "independent",
              "sharesChokepoint",
              "none"
            ]
          },
          "sharedChokepoints": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "noRouteReason": {
            "type": "string",
            "enum": [
              "noVerifiedExteriorExit",
              "incompleteConnectivity",
              "incompatibleMobility",
              "blockedByScenario",
              "missingBuildingPlan",
              "invalidGeometry",
              "unknownStartSpace"
            ]
          }
        },
        "required": [
          "alternativeStatus",
          "sharedChokepoints"
        ],
        "additionalProperties": false
      }
    },
    "directorState": {
      "type": "object",
      "properties": {
        "activeIncidentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "scheduledEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "awaitingUserAction": {
          "type": "boolean"
        },
        "stageID": {
          "type": "string",
          "maxLength": 120
        },
        "originSpaceID": {
          "type": "string",
          "maxLength": 120
        },
        "lastWait": {
          "type": "object",
          "properties": {
            "predicate": {
              "type": "string",
              "enum": [
                "nextIncident",
                "storedWaterUnavailable",
                "primaryContactChannelUnavailable"
              ]
            },
            "startedMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDurationMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4320
            },
            "stoppedMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "satisfied": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "enum": [
                "predicate",
                "mandatoryBoundary",
                "policyHorizon",
                "durationLimit"
              ]
            }
          },
          "required": [
            "predicate",
            "startedMinute",
            "maximumDurationMinutes",
            "stoppedMinute",
            "satisfied",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "activeIncidentCount",
        "scheduledEventCount"
      ],
      "additionalProperties": false
    },
    "spatial": {
      "type": "object",
      "properties": {
        "hazard": {
          "type": "string",
          "enum": [
            "freezePowerLoss",
            "heatGridStrain",
            "tornado",
            "flashFlood",
            "homeFire",
            "waterOutage"
          ]
        },
        "stageID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "originSpaceID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "affectedSpaceIDs": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "affectedPortalIDs": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "destinationSpaceID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "assumptionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "hazard",
        "stageID",
        "affectedSpaceIDs",
        "affectedPortalIDs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "routes"
  ],
  "additionalProperties": false
}
