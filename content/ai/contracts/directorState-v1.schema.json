{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "activeIncidentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "scheduledEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "awaitingUserAction": {
      "type": "boolean"
    },
    "stageID": {
      "type": "string",
      "maxLength": 120
    },
    "originSpaceID": {
      "type": "string",
      "maxLength": 120
    },
    "lastWait": {
      "type": "object",
      "properties": {
        "predicate": {
          "type": "string",
          "enum": [
            "nextIncident",
            "storedWaterUnavailable",
            "primaryContactChannelUnavailable"
          ]
        },
        "startedMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumDurationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4320
        },
        "stoppedMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "satisfied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "predicate",
            "mandatoryBoundary",
            "policyHorizon",
            "durationLimit"
          ]
        }
      },
      "required": [
        "predicate",
        "startedMinute",
        "maximumDurationMinutes",
        "stoppedMinute",
        "satisfied",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "activeIncidentCount",
    "scheduledEventCount"
  ],
  "additionalProperties": false
}
