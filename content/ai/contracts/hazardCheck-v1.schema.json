{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scenarioID": {
      "type": "string",
      "enum": [
        "home-fire",
        "tornado",
        "flash-flood",
        "freeze-power-loss",
        "heat-grid-strain",
        "water-outage"
      ]
    },
    "competencyID": {
      "type": "string",
      "enum": [
        "initialResponse",
        "adaptation",
        "communication",
        "continuity"
      ]
    },
    "actionKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "id",
    "scenarioID",
    "competencyID",
    "actionKind",
    "prompt"
  ],
  "additionalProperties": false
}
