{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "focus": {
      "type": "string",
      "enum": [
        "decision",
        "summary",
        "scene",
        "resources"
      ]
    },
    "sceneFirst": {
      "type": "boolean",
      "const": true
    },
    "renderFrom": {
      "type": "string",
      "const": "committedReceipt"
    },
    "narration": {
      "type": "string",
      "const": "unverifiedProposal"
    }
  },
  "required": [
    "focus",
    "sceneFirst",
    "renderFrom",
    "narration"
  ],
  "additionalProperties": false
}
